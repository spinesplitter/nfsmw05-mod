+// The game's own values, captured once.
+struct {
+    bool ok = false;
+    float rear[16];
+    int rearN = 0;
+    float stab[16];
+    int stabN = 0;
+} g;
+
+bool CaptureTables() {
+    int n = *(int*)kDriftRearTable;
+    float* v = *(float**)(kDriftRearTable + 0x10);
+    float* graph = *(float**)kDriftStabTable;
+    int m = *(int*)(kDriftStabTable + 4);
+    if (n <= 0 || n > 16 || !v || m <= 0 || m > 16 || !graph) {
+        Log("physics: unexpected drift tables (%d at %p, %d at %p)", n, v, m, graph);
+        return false;
+    }
+    g.rearN = n;
+    memcpy(g.rear, v, n * sizeof(float));
+    g.stabN = m;
+    for (int i = 0; i < m; i++) g.stab[i] = graph[i * 2 + 1];
+    g.ok = true;
+    return true;
+}
+
+// The player's ISuspension / IRigidBody interfaces, to recognise their objects.
+bool Owns(uint8_t* obj, void* iface) { return iface && (uint8_t*)iface >= obj && (uint8_t*)iface < obj + 0x300; }
+
+// Saved values while the player's suspension simulates.
+struct Saved {
+    float grip, slip, yaw;
+    float split;
+    float* tranny;
+};
+
+void Apply(uint8_t* susp, Saved& sv) {
+    const Config& c = g_cfg;
+    sv.grip = *(float*)kGlobalGripScale;
+    sv.slip = *(float*)kTractionFwdSlip;
+    sv.yaw = *(float*)kMaxYawBonus;
+    *(float*)kGlobalGripScale = sv.grip * c.grip;
+    // DoDriveForces scales the cut by Ramp(slip, 1, limit) = (slip - 1) / (limit - 1).
+    *(float*)kTractionFwdSlip = c.tractionControl > 0.01f ? 1.0f + (sv.slip - 1.0f) / c.tractionControl : 1.0e9f;
+    *(float*)kMaxYawBonus = sv.yaw * c.stability;
+    float* graph = *(float**)kDriftStabTable;
+    for (int i = 0; i < g.stabN; i++) graph[i * 2 + 1] = g.stab[i] * c.stability;
+    float* rear = *(float**)(kDriftRearTable + 0x10);
+    for (int i = 0; i < g.rearN; i++) rear[i] = 1.0f + (g.rear[i] - 1.0f) * c.driftAssist;
+    uint8_t* tranny = Field<uint8_t*>(susp, kSR_Tranny);
+    sv.tranny = tranny ? (float*)(tranny + kTR_TorqueSplit) : nullptr;
+    if (sv.tranny) {
+        sv.split = *sv.tranny;
+        // DrivetrainMode: the power goes where the chosen layout puts it (AWD keeps the car's own
+        // split if it has one, else 40% front).
+        int mode = (int)lrintf(c.drivetrainMode);
+        if (mode == 1) *sv.tranny = 1.0f;
+        else if (mode == 2) *sv.tranny = 0.0f;
+        else if (mode == 3) *sv.tranny = sv.split > 0.05f && sv.split < 0.95f ? sv.split : 0.4f;
+    }
+}
+
+void Restore(const Saved& sv) {
+    *(float*)kGlobalGripScale = sv.grip;
+    *(float*)kTractionFwdSlip = sv.slip;
+    *(float*)kMaxYawBonus = sv.yaw;
+    float* graph = *(float**)kDriftStabTable;
+    for (int i = 0; i < g.stabN; i++) graph[i * 2 + 1] = g.stab[i];
+    float* rear = *(float**)(kDriftRearTable + 0x10);
+    memcpy(rear, g.rear, g.rearN * sizeof(float));
+    if (sv.tranny) *sv.tranny = sv.split;
+}
+
+bool Stock() {
+    const Config& c = g_cfg;
+    return c.tractionControl >= 1.0f && c.stability >= 1.0f && c.driftAssist >= 1.0f && c.grip == 1.0f &&
+           c.speedGripLoss == 0.0f && c.drivetrainMode == 0.0f && c.engineLayout == 0.0f && c.weightTransfer == 0.0f &&
+           c.liftOff == 0.0f && c.slideInit == 0.0f && c.launchSpin == 0.0f && c.driftHelp == 0.0f && c.rearTyreGrip == 1.0f;
+}
+
+// Diagnostics: the player's physics step lengths (the game's forces divide by them).
+float s_suspDT = 0.0f;                  // the player's last suspension step
+float s_playerSpeed = 0.0f;             // m/s, from the player's rigid body at its last step
+
+// Side grip left at `speed` (m/s) for SpeedGripLoss `loss`: 1 - loss * (speed / 300 km/h)^2, at
+// least a tenth.
+float SpeedGrip(float loss, float speed) {
+    float r = speed / (300.0f / 3.6f);
+    return Clamp(1.0f - loss * r * r, 0.1f, 1.0f);
+}
+struct {
+    float rbMin = 1e9f, rbMax = 0.0f, suspMin = 1e9f, suspMax = 0.0f;
+    int steps = 0;
+    double since = 0;
+} s_dt;
+
+// --- handling model --------------------------------------------------------------------------
+constexpr float kG = 9.81f;
+// The player's body, from its rigid body steps: speed change (longitudinal acceleration, signed by
+// the speed growing or shrinking) and yaw rate about the world's up axis (y), smoothed.
+struct {
+    float speed = 0.0f, aLong = 0.0f, yawRate = 0.0f;
+    bool have = false;
+} s_body;
+
+// Wall bounce: the last hit on the world.
+struct {
+    double at = -1e9;
+    float normal[3] = {}, away = 0.0f;   // away: +1 / -1, which way along the normal leaves the wall
+    int logged = 0;
+} s_wall;
+
+// The model's state between steps.
+struct {
+    float load = 0.0f;          // smoothed longitudinal load shift (+ toward the rear)
+    float gasPrev = 0.0f;
+    float lift = 0.0f;          // lift-off event, 1 just after a quick lift, decaying
+    float lat[4] = {1.0f, 1.0f, 1.0f, 1.0f};   // the side grip factors in use (slide recovery)
+    float launch = 0.0f;        // launch wheelspin in progress, 0..2
+    float radius = 0.33f;       // the driven wheels' radius (m), learnt while cruising in grip
+    float slip = 0.0f;          // the driven wheels' slip at the last step, for the log
+    float rearAnglePrev = 0.0f; // the rear slip angle at the last step (is the slide growing?)
+    float yawSign = 0.0f;       // learnt: sign of the yaw rate when steering right in grip
+    int yawVotes = 0;
+    std::string car;
+    double lastLog = 0;
+} s_hm;
+
+float Smooth01(float x) {
+    x = Clamp(x, 0.0f, 1.0f);
+    return x * x * (3.0f - 2.0f * x);
+}
+
+// The rear tyres' larger slip angle, in degrees (0 if unknown).
+float RearSlip(uint8_t* const tires[4]) {
+    float a = 0.0f;
+    for (int i = 2; i < 4; i++) {
+        float d = tires[i] ? fabsf(Field<float>(tires[i], kTire_SlipAngle)) * 360.0f : 0.0f;
+        if (d < 90.0f) a = std::max(a, d);
+    }
+    return a;
+}
+
+// Front share of the torque for the step (after DrivetrainMode), and its class for the log.
+const char* DriveName(float front) { return front >= 0.95f ? "FWD" : front <= 0.05f ? "RWD" : "AWD"; }
+
+// The model for one suspension step of the player's car: fills s_latMul (side grip) and s_tracMul
+// (whole grip) per tyre, front left, front right, rear left, rear right.
+void HandlingStep(uint8_t* susp, float dT, uint8_t* const tires[4]) {
+    const Config& c = g_cfg;
+    uint8_t* tranny = Field<uint8_t*>(susp, kSR_Tranny);
+    float front = tranny ? Clamp(Field<float>(tranny, kTR_TorqueSplit), 0.0f, 1.0f) : 0.0f;   // after Apply
+    float rearShare = 1.0f - front;
+    InputSnapshot in = Input_Get();
+    float gas = in.pedalBound[0] ? Clamp(in.pedal[0], 0.0f, 1.0f) : 0.0f;
+    float hb = Clamp(in.handbrake, 0.0f, 1.0f);
+    float steer = in.steerBound ? in.steer : 0.0f;
+    float rpm = Game_RpmRatio();   // rpm / redline, 0 unknown
+    float speed = s_body.speed;
+    float aLat = fabsf(s_body.yawRate) * speed;
+    int layout = (int)lrintf(c.engineLayout);
+
+    const char* car = Physics_Car();
+    if (s_hm.car != car) {
+        s_hm.car = car;
+        Log("physics: %s drivetrain %s (torque split %.2f front%s), engine %s", car[0] ? car : "?", DriveName(front), front,
+            c.drivetrainMode > 0.5f ? ", set for this car" : "", layout == 0 ? "front" : layout == 1 ? "mid" : "rear");
+    }
+
+    // Weight transfer: + to the rear when accelerating. Front engines shift a little less, rear
+    // engines more (and their nose is light: less static front bite).
+    float sens = layout == 0 ? 0.9f : layout == 1 ? 1.0f : 1.2f;
+    float target = Clamp(s_body.aLong / kG * 0.5f * c.weightTransfer * sens, -0.3f, 0.3f);
+    float k = dT > 0.0f ? 1.0f - expf(-dT / 0.12f) : 1.0f;
+    s_hm.load += (target - s_hm.load) * k;
+    float staticF = layout == 0 ? 0.97f : 1.0f, staticR = layout == 2 ? 1.03f : 1.0f;
+    float cornerLoad = 1.0f - 0.06f * c.weightTransfer * Clamp(aLat / kG, 0.0f, 1.5f);
+    float tracF = staticF * (1.0f - s_hm.load) * cornerLoad;
+    float tracR = staticR * (1.0f + s_hm.load) * cornerLoad * c.rearTyreGrip;   // RearTyreGrip: the rear's whole grip
+
+    // Lift-off: how quickly the throttle closed (full lift in ~0.15 s gives 1), decaying over ~0.5 s.
+    float liftRate = dT > 0.0f ? std::max(0.0f, (s_hm.gasPrev - gas) / dT) : 0.0f;
+    s_hm.gasPrev = gas;
+    s_hm.lift = std::max(s_hm.lift * (dT > 0.0f ? expf(-dT / 0.5f) : 1.0f), Clamp(liftRate / 6.0f, 0.0f, 1.0f));
+    float lift = c.liftOff * s_hm.lift * Clamp(aLat / (0.4f * kG), 0.0f, 1.0f) * Clamp(speed / 15.0f, 0.0f, 1.0f);
+
+    // Launch wheelspin, from the driven wheels' real slip: their surface speed (the engine's
+    // differential angular velocity times the wheel radius, learnt while cruising in grip) against
+    // the road speed. A launch (high rpm and throttle from low speed) starts it; it then lasts as
+    // long as the wheels really spin with the throttle held, whatever the speed, and fades as the
+    // slip closes or the throttle eases: wheelspin feeds itself, grip comes back when it stops.
+    float w = Game_DrivenWheelSpeed();
+    if (gas < 0.2f && speed > 8.0f && fabsf(w) > 5.0f && in.pedalBound[1] && in.pedal[1] < 0.05f && RearSlip(tires) < 3.0f) {
+        float r = speed / fabsf(w);
+        if (r > 0.2f && r < 0.6f) s_hm.radius += (r - s_hm.radius) * 0.02f;
+    }
+    float surface = fabsf(w) * s_hm.radius;
+    float slip = Clamp((surface - speed) / std::max(speed, 3.0f), 0.0f, 3.0f);
+    float throttle = Clamp((gas - 0.5f) / 0.4f, 0.0f, 1.0f);
+    float start = Clamp((rpm - 0.55f) / 0.35f, 0.0f, 1.0f) * Clamp(1.0f - speed / 12.0f, 0.0f, 1.0f);
+    float keep = Clamp((slip - 0.08f) / 0.3f, 0.0f, 1.0f) * Clamp(1.0f - speed / 35.0f, 0.0f, 1.0f);   // never endless
+    float spinTarget = c.launchSpin * throttle * std::max(start, keep);
+    float kl = dT > 0.0f ? 1.0f - expf(-dT / (spinTarget > s_hm.launch ? 0.08f : 0.25f)) : 1.0f;
+    s_hm.launch += (spinTarget - s_hm.launch) * kl;
+    float launch = s_hm.launch;
+    s_hm.slip = slip;
+    float driven = std::max(front, rearShare);
+    float spinF = 1.0f - 0.35f * Clamp(launch, 0.0f, 1.5f) * (driven > 0.0f ? front / driven : 0.0f);
+    float spinR = 1.0f - 0.35f * Clamp(launch, 0.0f, 1.5f) * (driven > 0.0f ? rearShare / driven : 0.0f);
+    for (int i = 0; i < 4; i++) s_tracMul[i] = i < 2 ? tracF * spinF : tracR * spinR;
+
+    // Side grip per tyre.
+    float fall = c.cornerGrip < 0.5f ? 0.30f : c.cornerGrip < 1.5f ? 0.18f : 0.08f;
+    fall *= 0.7f + 0.3f * Clamp(c.slideInit, 0.0f, 2.0f);   // excess cornering speed slides more readily
+    float speedF = 0.6f + 0.4f * Clamp(speed / 45.0f, 0.0f, 1.0f);
+    float power = rearShare * Clamp((gas - 0.5f) / 0.5f, 0.0f, 1.0f) * Clamp((rpm - 0.5f) / 0.4f, 0.0f, 1.0f) *
+                  Clamp(aLat / (0.3f * kG), 0.0f, 1.0f);
+    float rearAngle = 0.0f;
+    float angle[4] = {};
+    for (int i = 0; i < 4; i++) {
+        angle[i] = tires[i] ? fabsf(Field<float>(tires[i], kTire_SlipAngle)) * 360.0f : 0.0f;
+        if (!(angle[i] < 90.0f)) angle[i] = 0.0f;   // NaN or nonsense
+        if (i >= 2) rearAngle = std::max(rearAngle, angle[i]);
+    }
+    // Countersteer: steering against the way the car rotates. The yaw sign for a right turn is
+    // learnt while the car turns in grip (rear slip under 3 deg).
+    if (in.steerBound && fabsf(steer) > 0.15f && rearAngle < 3.0f && speed > 8.0f && fabsf(s_body.yawRate) > 0.1f &&
+        s_hm.yawVotes < 400) {
+        s_hm.yawSign += (steer > 0.0f) == (s_body.yawRate > 0.0f) ? 1.0f : -1.0f;
+        if (++s_hm.yawVotes == 400) Log("physics: steering right turns the car %s (yaw rate sign learnt)", s_hm.yawSign > 0 ? "+" : "-");
+    }
+    bool counter = s_hm.yawVotes >= 50 && fabsf(steer) > 0.1f && fabsf(s_body.yawRate) > 0.05f &&
+                   ((steer > 0.0f) == (s_body.yawRate > 0.0f)) != (s_hm.yawSign > 0.0f);
+    // Catchable slides: countersteer help from 4 deg of rear slip (0.12 per DriftHelp level, so High
+    // gives back a quarter of the side grip), and while countersteering the throttle and lift-off
+    // take half as much. Grip comes back twice as fast while the slide is shrinking.
+    float help = counter ? 0.12f * c.driftHelp * Clamp((rearAngle - 4.0f) / 10.0f, 0.0f, 1.0f) : 0.0f;
+    float calm = counter ? 0.5f : 1.0f;
+    bool shrinking = rearAngle < s_hm.rearAnglePrev - 0.02f;
+    s_hm.rearAnglePrev = rearAngle;
+    float rise = (0.6f + 0.7f * c.slideRecovery) * (shrinking ? 2.0f : 1.0f) * dT;   // side grip regained per step
+    float fast = SpeedGrip(c.speedGripLoss, speed);
+    for (int i = 0; i < 4; i++) {
+        // A tyre past its peak loses side grip up to ~25 deg, then levels off (a fully sliding tyre
+        // keeps most of its friction): 40% of the loss comes back by 45 deg, so a big slide is not
+        // a one-way spin.
+        float past = Smooth01((angle[i] - 7.0f) / 18.0f) * (1.0f - 0.4f * Smooth01((angle[i] - 25.0f) / 20.0f));
+        float t = 1.0f - fall * past * speedF;
+        if (i >= 2) {
+            t *= 1.0f - 0.18f * lift * (0.4f + 0.6f * rearShare) * calm;
+            t *= 1.0f - 0.15f * c.slideInit * power * calm;
+            t = std::max(t, 0.65f);                     // the model alone never takes more than a third
+            t *= 1.0f - 0.25f * c.slideInit * hb;       // the handbrake may
+            t += help;
+        } else {
+            t *= 1.0f + 0.05f * lift;
+            t += help * 0.6f;
+            if (counter) t = std::max(t, 0.85f);        // the front keeps biting while you catch it
+        }
+        t = Clamp(t, 0.3f, 1.1f);
+        float& m = s_hm.lat[i];
+        m = t < m ? t : std::min(t, m + rise);   // grip drops at once, comes back progressively
+        s_latMul[i] = m * fast;
+    }
+
+    if (g_cfg.logInputs && Now() - s_hm.lastLog > 1.0) {
+        s_hm.lastLog = Now();
+        Log("physics: model %s speed %.1f aLong %+.1f aLat %.1f load %+.2f lift %.2f launch %.2f (wheel slip %.2f, radius %.2f) power %.2f rear slip %.1f "
+            "grip F %.2f/%.2f R %.2f/%.2f side %.2f %.2f %.2f %.2f%s", DriveName(front), speed, s_body.aLong, aLat, s_hm.load,
+            lift, launch, s_hm.slip, s_hm.radius, power, rearAngle, s_tracMul[0], s_tracMul[1], s_tracMul[2], s_tracMul[3], s_latMul[0], s_latMul[1],
+            s_latMul[2], s_latMul[3], counter ? " countersteer" : "");
+    }
+}
+
+// The body's motion for the model and the wall bounce, from the player's rigid body step.
+void BodyStep(uint8_t* data, float dT) {
+    float* v = (float*)(data + kRV_LinearVel);
+    const float* w = (const float*)(data + kRV_AngularVel);
+    float speed = sqrtf(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+    if (!(speed < 300.0f)) return;   // NaN or nonsense
+    if (s_body.have && dT > 0.0f) {
+        float a = Clamp((speed - s_body.speed) / dT, -30.0f, 30.0f);
+        float k = 1.0f - expf(-dT / 0.08f);
+        s_body.aLong += (a - s_body.aLong) * k;
+        s_body.yawRate += (w[1] - s_body.yawRate) * k;
+    }
+    s_body.speed = speed;
+    s_body.have = true;
+
+    // Wall bounce: the velocity leaving the wall along its normal, kept at WallBounce of it.
+    if (Now() - s_wall.at < 0.25 && g_cfg.wallBounce < 1.0f) {
+        const float* n = s_wall.normal;
+        float vn = (v[0] * n[0] + v[1] * n[1] + v[2] * n[2]) * s_wall.away;
+        if (vn > 0.0f) {
+            float cut = vn * (1.0f - g_cfg.wallBounce);
+            for (int a = 0; a < 3; a++) v[a] -= n[a] * s_wall.away * cut;
+            if (s_wall.logged < 5) {
+                s_wall.logged++;
+                Log("physics: wall rebound %.1f m/s, %.1f m/s of it taken away (speed %.1f)", vn, cut, speed);
+            }
+        }
+    }
+}
+
+void __fastcall Hook_SuspSimulate(uint8_t* susp, void*, float dT) {
+    bool player = Owns(susp, Game_PlayerInterface((void*)kISuspensionHandle));
+    s_playerSusp = player;
+    if (player) {
+        uint8_t* tranny = Field<uint8_t*>(susp, kSR_Tranny);
+        if (tranny) s_carSplit = Field<float>(tranny, kTR_TorqueSplit);   // the car's own, before DrivetrainMode
+        s_suspDT = dT;
+        s_dt.suspMin = std::min(s_dt.suspMin, dT);
+        s_dt.suspMax = std::max(s_dt.suspMax, dT);
+    }
+    if (!player || !g.ok || !g_cfg.physics || Stock()) {
+        s_origSusp(susp, dT);
+        s_playerSusp = false;
+        return;
+    }
+    static uint8_t* logged;
+    if (logged != susp) {
+        logged = susp;
+        uint8_t* tranny = Field<uint8_t*>(susp, kSR_Tranny);
+        Log("physics: player suspension %p (torque split %.2f front)", susp, tranny ? Field<float>(tranny, kTR_TorqueSplit) : -1.0f);
+    }
+    Saved sv;
+    Apply(susp, sv);   // DrivetrainMode first: the model reads the split the step will use
+    uint8_t* iface = (uint8_t*)Game_PlayerInterface((void*)kISuspensionHandle);
+    for (int i = 0; i < 4; i++) {
+        uint8_t* t = iface ? *(uint8_t**)(iface + kSuspIface_Tires + i * 4) : nullptr;
+        s_latTires[i] = (uintptr_t)t >= 0x10000 && (uintptr_t)t < 0x7FFF0000 ? t : nullptr;
+    }
+    HandlingStep(susp, dT, s_latTires);
+    s_origSusp(susp, dT);
+    for (uint8_t*& t : s_latTires) t = nullptr;
+    for (float& m : s_tracMul) m = 1.0f;
+    Restore(sv);
+    s_playerSusp = false;
+}
+
+// In place of UpdateLoaded's fmul [esi+0xEC] (6 bytes: a call and a nop): the same multiply and
+// the slide grip factor.
+__asm__(
+    ".text\n"
+    "_SlideFrictionStub:\n"
+    "    fmuls 0xEC(%esi)\n"
+    "    fmuls _s_slideGrip\n"
+    "    ret\n");
+extern "C" void SlideFrictionStub();
+
+// In place of UpdateLoaded's fld [ecx+0xF0] (6 bytes): the same load, times s_latMul for a tyre in
+// s_latTires. eax is kept; the flags are free here (the next test sets them again).
+__asm__(
+    ".text\n"
+    "_LateralGripStub:\n"
+    "    flds 0xF0(%ecx)\n"
+    "    pushl %eax\n"
+    "    xorl %eax, %eax\n"
+    "1:  cmpl _s_latTires(,%eax,4), %esi\n"
+    "    je 2f\n"
+    "    incl %eax\n"
+    "    cmpl $4, %eax\n"
+    "    jb 1b\n"
+    "    popl %eax\n"
+    "    ret\n"
+    "2:  fmuls _s_latMul(,%eax,4)\n"
+    "    popl %eax\n"
+    "    ret\n");
+extern "C" void LateralGripStub();
+
+// Called from TuneWheelParams for each blown tire, in place of the game's code.
+void __cdecl Hook_BlownTire(uint8_t* tire) {
+    float& brake = Field<float>(tire, kTire_Brake);
+    float& traction = Field<float>(tire, kTire_Traction);
+    if (!s_playerSusp || !g_cfg.poppedTires) {
+        Field<float>(tire, kTire_EBrake) = 0.0f;
+        brake = 1.0f;
+        traction *= 0.3f;
+        return;
+    }
+    float k = g_cfg.tireHandicap;
+    brake = std::max(brake, std::min(kPoppedDrag * k, 1.0f));
+    traction *= 1.0f - std::min(kPoppedTraction * k, 0.95f);
+}
+
+// Drop from the air (testing): requested by the menu, done in the player's next OnBeginFrame.
+volatile double s_dropAt = -1;
+
+void DropIfAsked(uint8_t* rb) {
+    if (s_dropAt < 0) return;
+    if (Now() - s_dropAt > 2.0) {   // not in a car: forget it
+        s_dropAt = -1;
+        return;
+    }
+    if (!Owns(rb, Game_PlayerInterface((void*)kIRigidBodyHandle))) return;
+    s_dropAt = -1;
+    uint8_t** holder = Field<uint8_t**>(rb, kRB_Data);
+    uint8_t* data = holder ? *holder : nullptr;
+    if (!data) return;
+    float* pos = (float*)(data + kRV_Position);
+    float* vel = (float*)(data + kRV_LinearVel);
+    float* av = (float*)(data + kRV_AngularVel);
+    pos[1] += g_cfg.dropHeight;
+    vel[1] = 0.0f;
+    av[0] = av[1] = av[2] = 0.0f;
+    Log("physics: car dropped from %.1f m (speed %.1f m/s)", g_cfg.dropHeight, sqrtf(vel[0] * vel[0] + vel[2] * vel[2]));
+}
+
+// The player's body: its spin limited to [Physics] MaxSpin.
+void LimitSpin(uint8_t* rb) {
+    float limit = g_cfg.maxSpin;
+    if (limit <= 0.0f || !Owns(rb, Game_PlayerInterface((void*)kIRigidBodyHandle))) return;
+    uint8_t** holder = Field<uint8_t**>(rb, kRB_Data);
+    uint8_t* data = holder ? *holder : nullptr;
+    if (!data) return;
+    float* av = (float*)(data + kRV_AngularVel);
+    float w = sqrtf(av[0] * av[0] + av[1] * av[1] + av[2] * av[2]);
+    if (!(w > limit)) return;   // also skips NaN
+    float k = limit / w;
+    av[0] *= k;
+    av[1] *= k;
+    av[2] *= k;
+    static double lastLog = -1e9;
+    if (Now() - lastLog > 1.0) {
+        lastLog = Now();
+        const float* v = (const float*)(data + kRV_LinearVel);
+        Log("physics: car spinning at %.1f rad/s, limited to %.1f (speed %.1f m/s, vertical %+.1f)", w, limit,
+            sqrtf(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]), v[1]);
+    }
+}
+
+// Before the player's body integrates: the torque scaled so the spin it adds stays within MaxSpin.
+// Returns the spin predicted after the step (for the check after it), or false if not limited.
+bool LimitTorque(uint8_t* rb, float dT, float predicted[3]) {
+    float limit = g_cfg.maxSpin;
+    if (limit <= 0.0f || !(dT > 0.0f) || !Owns(rb, Game_PlayerInterface((void*)kIRigidBodyHandle))) return false;
+    uint8_t** holder = Field<uint8_t**>(rb, kRB_Data);
+    uint8_t* data = holder ? *holder : nullptr;
+    if (!data || data[0x5D] != 0) return false;            // not awake: no integration
+    float* T = (float*)(data + kRV_Torque);
+    const float* av = (const float*)(data + kRV_AngularVel);
+    const float* M = (const float*)(rb + kRB_InvWorldTensor);
+    float d[3];
+    for (int i = 0; i < 3; i++) d[i] = (T[0] * M[i] + T[1] * M[4 + i] + T[2] * M[8 + i]) * dT;
+    float w1[3] = {av[0] + d[0], av[1] + d[1], av[2] + d[2]};
+    float n1 = sqrtf(w1[0] * w1[0] + w1[1] * w1[1] + w1[2] * w1[2]);
+    float s = 1.0f;
+    float dn = sqrtf(d[0] * d[0] + d[1] * d[1] + d[2] * d[2]);
+    const char* why = nullptr;
+    if (dn > kMaxSpinAccel * dT) {
+        s = kMaxSpinAccel * dT / dn;
+        why = "spike";
+    }
+    float ws[3] = {av[0] + d[0] * s, av[1] + d[1] * s, av[2] + d[2] * s};
+    if (sqrtf(ws[0] * ws[0] + ws[1] * ws[1] + ws[2] * ws[2]) > limit) {
+        why = "spin";
+        // The largest share s of the torque with |av + s d| <= limit (|av| <= limit already).
+        float dd = d[0] * d[0] + d[1] * d[1] + d[2] * d[2];
+        float wd = av[0] * d[0] + av[1] * d[1] + av[2] * d[2];
+        float ww = av[0] * av[0] + av[1] * av[1] + av[2] * av[2];
+        float disc = wd * wd - dd * (ww - limit * limit);
+        s = std::min(s, dd > 1e-12f && disc >= 0.0f ? std::max(0.0f, std::min(1.0f, (-wd + sqrtf(disc)) / dd)) : 0.0f);
+    }
+    if (why) {
+        static double lastLog = -1e9;
+        if (Now() - lastLog > 1.0) {
+            lastLog = Now();
+            float tn = sqrtf(T[0] * T[0] + T[1] * T[1] + T[2] * T[2]);
+            Log("physics: torque %.0f N m (%s) would change the spin by %.1f to %.1f rad/s in one step: scaled to %.4f "
+                "(step %.5f s, suspension step %.5f s)", tn, why, dn, n1, s, dT, s_suspDT);
+        }
+        for (int i = 0; i < 3; i++) T[i] *= s;
+    } else if (!(n1 >= 0.0f)) {
+        return false;                                       // NaN: leave it to the game
+    }
+    for (int i = 0; i < 3; i++) predicted[i] = av[i] + d[i] * s;
+    return true;
+}
+
+// After the step: how well LimitTorque predicted the spin (a few times, to confirm the layout).
+void CheckPrediction(uint8_t* rb, const float predicted[3], const float before[3]) {
+    static int checked = 0;
+    if (checked >= 3) return;
+    uint8_t** holder = Field<uint8_t**>(rb, kRB_Data);
+    uint8_t* data = holder ? *holder : nullptr;
+    if (!data) return;
+    const float* av = (const float*)(data + kRV_AngularVel);
+    float change = 0, err = 0;
+    for (int i = 0; i < 3; i++) {
+        change += (predicted[i] - before[i]) * (predicted[i] - before[i]);
+        err += (av[i] - predicted[i]) * (av[i] - predicted[i]);
+    }
+    if (sqrtf(change) < 0.05f) return;                      // too small to tell
+    checked++;
+    Log("physics: spin change predicted %.3f rad/s, off by %.4f", sqrtf(change), sqrtf(err));
+}
+
+// A tyre on an off-road surface, by the surface's own name.
+bool OffroadTire(uint8_t* tire) {
+    uintptr_t layout = *(uintptr_t*)(tire + kTire_Surface + 8);
+    if (layout < 0x10000 || layout >= 0x7FFF0000) return false;
+    const char* name = *(const char**)(layout + kSurf_Name);
+    if ((uintptr_t)name < 0x10000 || (uintptr_t)name >= 0x7FFF0000 || IsBadStringPtrA(name, 32)) return false;
+    static const char* const kWords[] = {"grass", "dirt", "mud", "gravel", "sand", "soil", "earth", "field",
+                                         "offroad", "off_road", "forest", "bush", "shrub", "snow", "rock"};
+    char low[48] = {};
+    for (int k = 0; k < 47 && name[k]; k++) low[k] = (char)tolower((unsigned char)name[k]);
+    for (const char* w : kWords)
+        if (strstr(low, w)) return true;
+    return false;
+}
+
+// Rain intensity in the player's view (0 = dry), checked against nonsense.
+float RainIntensity() {
+    uintptr_t rain = *(uintptr_t*)kPlayerRain;
+    if (rain < 0x10000 || rain >= 0x7FFF0000) return 0.0f;
+    float v = *(float*)(rain + kRain_Intensity);
+    float r = v >= 0.0f && v <= 10.0f ? v : 0.0f;
+    static float logged = -1.0f;
+    if (fabsf(r - logged) > 0.1f || (r > 0.0f) != (logged > 0.0f)) {
+        logged = r;
+        Log("physics: rain intensity %.2f", r);
+    }
+    return r;
+}
+
+typedef void(__thiscall* DoDrifting_t)(void* susp, void* state);
+
+void __fastcall Hook_DoDrifting(uint8_t* susp, void*, void* state) {
+    ((DoDrifting_t)kDoDrifting)(susp, state);
+    if (!s_playerSusp || !g_cfg.physics) return;
+    float off = g_cfg.offroadGrip;
+    // Full RainGrip from a light rain on (intensity 0.3).
+    float wet = 1.0f - (1.0f - g_cfg.rainGrip) * std::min(RainIntensity() / 0.3f, 1.0f);
+    uint8_t* iface = (uint8_t*)Game_PlayerInterface((void*)kISuspensionHandle);
+    if (!iface) return;
+    for (int i = 0; i < 4; i++) {
+        uint8_t* tire = *(uint8_t**)(iface + kSuspIface_Tires + i * 4);
+        if ((uintptr_t)tire < 0x10000 || (uintptr_t)tire >= 0x7FFF0000) continue;
+        float k = s_tracMul[i] * wet;   // the handling model's weight transfer and launch wheelspin
+        if (off != 1.0f && OffroadTire(tire)) k *= off;
+        Field<float>(tire, kTire_Traction) *= k;
+    }
+}
+
+void __fastcall Hook_RBBeginFrame(uint8_t* rb, void*, float dT) {
+    DropIfAsked(rb);
+    if (Owns(rb, Game_PlayerInterface((void*)kIRigidBodyHandle))) {
+        uint8_t** holder = Field<uint8_t**>(rb, kRB_Data);
+        if (holder && *holder) {
+            const float* v = (const float*)(*holder + kRV_LinearVel);
+            s_playerSpeed = sqrtf(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+            if (g_cfg.physics) BodyStep(*holder, dT);
+        }
+        s_dt.rbMin = std::min(s_dt.rbMin, dT);
+        s_dt.rbMax = std::max(s_dt.rbMax, dT);
+        s_dt.steps++;
+        if (Now() - s_dt.since > 10.0) {
+            if (s_dt.since > 0)
+                Log("physics: %d steps in %.0f s, step %.5f..%.5f s, suspension step %.5f..%.5f s", s_dt.steps,
+                    Now() - s_dt.since, s_dt.rbMin, s_dt.rbMax, s_dt.suspMin, s_dt.suspMax);
+            s_dt = {};
+            s_dt.since = Now();
+        }
+    }
+    LimitSpin(rb);
+    float predicted[3], before[3] = {0, 0, 0};
+    bool limited = LimitTorque(rb, dT, predicted);
+    if (limited) {
+        const float* av = (const float*)(*Field<uint8_t**>(rb, kRB_Data) + kRV_AngularVel);
+        for (int i = 0; i < 3; i++) before[i] = av[i];
+    }
+    float k = g_cfg.gravity;
+    uint8_t* specs = Field<uint8_t*>(rb, kRB_Specs);
+    if (!g_cfg.physics || k == 1.0f || !specs ||
+        !(g_cfg.gravityAll ? Game_PlayerInterface(nullptr) != nullptr   // in game, any car
+                           : Owns(rb, Game_PlayerInterface((void*)kIRigidBodyHandle)))) {
+        s_origRB(rb, dT);
+    } else {
+        float& gravity = Field<float>(specs, 0xF0);
+        float saved = gravity;
+        gravity = saved * k;
+        s_origRB(rb, dT);
+        gravity = saved;
+    }
+    if (limited) CheckPrediction(rb, predicted, before);
+    LimitSpin(rb);   // after integrating: the next suspension step starts from a sane spin
+}
+
+bool Expect(uintptr_t at, std::initializer_list<uint8_t> bytes) {
+    size_t i = 0;
+    for (uint8_t b : bytes) {
+        if (((uint8_t*)at)[i] != b) {
+            Log("physics: unexpected code at 0x%06X+%u", (unsigned)at, (unsigned)i);
+            return false;
+        }
+        i++;
+    }
+    return true;
+}
+
+// Jumps from `at` to `hook`; returns a trampoline running the `stolen` bytes and jumping back.
+void* Detour(uintptr_t at, size_t stolen, void* hook) {
+    uint8_t* tramp = (uint8_t*)VirtualAlloc(nullptr, 32, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+    if (!tramp) return nullptr;
+    memcpy(tramp, (void*)at, stolen);
+    tramp[stolen] = 0xE9;
+    *(int32_t*)(tramp + stolen + 1) = (int32_t)((at + stolen) - ((uintptr_t)tramp + stolen + 5));
+    DWORD old;
+    VirtualProtect((void*)at, stolen, PAGE_EXECUTE_READWRITE, &old);
+    uint8_t* p = (uint8_t*)at;
+    p[0] = 0xE9;
+    *(int32_t*)(p + 1) = (int32_t)((uintptr_t)hook - (at + 5));
+    for (size_t i = 5; i < stolen; i++) p[i] = 0x90;
+    VirtualProtect((void*)at, stolen, old, &old);
+    FlushInstructionCache(GetCurrentProcess(), (void*)at, stolen);
+    return tramp;
+}
+
+void InstallBlownTire() {
+    // mov eax,[edx]; mov [eax+0xCC],0; mov eax,[edx]; mov [eax+0xC8],1.0; mov eax,[edx];
+    // fld [eax+0xEC]; fmul [0.3]; fstp [eax+0xEC]
+    if (!Expect(kBlownTire, {0x8B, 0x02, 0xC7, 0x80, 0xCC, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x8B, 0x02,
+                             0xC7, 0x80, 0xC8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x3F, 0x8B, 0x02, 0xD9, 0x80,
+                             0xEC, 0x00, 0x00, 0x00, 0xD8, 0x0D, 0x58, 0x4B, 0x89, 0x00, 0xD9, 0x98, 0xEC, 0x00,
+                             0x00, 0x00})) {
+        Log("physics: popped tires unavailable");
+        g_cfg.poppedTires = false;
+        return;
+    }
+    // ecx (wheel index) and edx (tire pointer slot) live across the call; the x87 stack is empty.
+    uint8_t code[kBlownTireLen];
+    memset(code, 0x90, sizeof(code));
+    uint8_t* p = code;
+    *p++ = 0x51;                                        // push ecx
+    *p++ = 0x52;                                        // push edx
+    *p++ = 0xFF; *p++ = 0x32;                           // push dword [edx]  (the Tire*)
+    *p++ = 0xE8;                                        // call Hook_BlownTire
+    *(int32_t*)p = (int32_t)((uintptr_t)&Hook_BlownTire - (kBlownTire + (p + 4 - code)));
+    p += 4;
+    *p++ = 0x83; *p++ = 0xC4; *p++ = 0x04;              // add esp,4
+    *p++ = 0x5A;                                        // pop edx
+    *p++ = 0x59;                                        // pop ecx
+    *p++ = 0xE9;                                        // jmp past the original code
+    *(int32_t*)p = (int32_t)((kBlownTire + kBlownTireLen) - (kBlownTire + (p + 4 - code)));
+    DWORD old;
+    VirtualProtect((void*)kBlownTire, sizeof(code), PAGE_EXECUTE_READWRITE, &old);
+    memcpy((void*)kBlownTire, code, sizeof(code));
+    VirtualProtect((void*)kBlownTire, sizeof(code), old, &old);
+    FlushInstructionCache(GetCurrentProcess(), (void*)kBlownTire, sizeof(code));
+    Log("physics: popped tires %s (handicap %.2f)", g_cfg.poppedTires ? "drivable" : "as in the game", g_cfg.tireHandicap);
+}
