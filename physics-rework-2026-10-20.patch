+static HWND CreateHiddenWindow() {
+    return CreateWindowExA(WS_EX_TOOLWINDOW, "STATIC", "nfsmw_gameplay", WS_POPUP, 0, 0, 1, 1,
+                           nullptr, nullptr, GetModuleHandleA(nullptr), nullptr);
