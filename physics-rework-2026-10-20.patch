-bool Stock() {
-    const Config& c = g_cfg;
-    return c.tractionControl >= 1.0f && c.stability >= 1.0f && c.driftAssist >= 1.0f && c.grip == 1.0f &&
-           c.torqueSplit == 1.0f && c.drivetrain == 1.0f && c.slideGrip == 1.0f && c.slideOversteer == 1.0f &&
-           c.speedGripLoss == 0.0f;
