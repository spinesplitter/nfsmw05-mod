-bool Expect(uintptr_t at, std::initializer_list<uint8_t> bytes) {
-    size_t i = 0;
-    for (uint8_t b : bytes) {
-        if (((uint8_t*)at)[i] != b) {
-            Log("physics: unexpected code at 0x%06X+%u", (unsigned)at, (unsigned)i);
-            return false;
-        }
-        i++;
-    }
-    return true;
-}
