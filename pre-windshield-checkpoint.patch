+    if (!strcmp(name, "CARRERAGT_KIT00_LEFT_SIDE_MIRROR_A")) return 0;
+    if (!strcmp(name, "CARRERAGT_KIT00_RIGHT_SIDE_MIRROR_A")) return 1;
