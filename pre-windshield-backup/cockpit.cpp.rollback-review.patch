+// Car coordinates: x forward, y left, z up. Require the entire triangle inside the
+// front glazing region and a sloping front-facing normal, never the roof or side windows.
+bool WindshieldCandidate(const TriRef& t, const V3& head) {
+    for (const V3& p : t.p)
+        if (p.x < head.x + 0.20f || p.x > head.x + 1.65f || fabsf(p.y) > 0.92f ||
+            p.z < head.z - 0.40f || p.z > head.z + 0.50f) return false;
+    V3 n = Cross(Sub(t.p[1], t.p[0]), Sub(t.p[2], t.p[0]));
+    float len = sqrtf(Dot(n, n));
+    return len > 1e-6f && fabsf(n.x) > len * 0.35f && fabsf(n.z) > len * 0.20f && fabsf(n.y) < len * 0.55f;
+}
+
+void NoteWindshield(uint8_t* solid, SolidInfo& info, const float* m) {
+    // Do not add glass to traffic, exterior cameras or a player car not currently seated.
+    if (!s_seatedConn || s_curConn != s_seatedConn) return;
+    int eyeSerial = s_hashSerial * 4 + s_eyeIndex;
+    if (info.windshieldEye == eyeSerial) return;
+    info.windshieldEye = eyeSerial;
+    std::string name = SolidName(info);
+    const HeadPos* head = CarHead(name.c_str());
+    if (!head) return; // retry after the driver has been measured
+    if (info.windshieldGen != s_editsGen || info.trisDirty) {
+        if (info.trisDirty) BuildTris(solid, info);
+        info.windshield.clear();
+        const EditSet& e = EditsFor(name);
+        std::vector<const TriRef*> automatic;
+        float area = 0, lo = 1e9f, hi = -1e9f;
+        bool body = name.find("_BODY_") != std::string::npos || name.find("_WINDOW") != std::string::npos;
+        for (const TriRef& t : info.tris) {
+            if (body && !t.hidden && WindshieldCandidate(t, {head->v[0], head->v[1], head->v[2]})) {
+                automatic.push_back(&t);
+                V3 n = Cross(Sub(t.p[1], t.p[0]), Sub(t.p[2], t.p[0]));
+                area += sqrtf(Dot(n, n)) * 0.5f;
+                for (const V3& p : t.p) { lo = std::min(lo, p.y); hi = std::max(hi, p.y); }
+            }
+        }
+        std::set<uint64_t> ids;
+        if (area > 0.18f && hi - lo > 0.70f)
+            for (auto t : automatic) ids.insert(t->id);
+        ids.insert(e.windshield.begin(), e.windshield.end());
+        for (const TriRef& t : info.tris)
+            if (ids.count(t.id) && !e.noWindshield.count(t.id) && !e.hide.count(t.id) && !e.black.count(t.id))
+                info.windshield.insert(info.windshield.end(), t.p, t.p + 3);
+        info.windshieldGen = s_editsGen;
+        Log("windshield: %s: %u interior glass triangles", name.c_str(), (unsigned)info.windshield.size() / 3);
+    }
+    std::vector<float> xyz;
+    for (const V3& p : info.windshield) {
+        V3 w = ToWorld(p, m);
+        xyz.insert(xyz.end(), {w.x, w.y, w.z});
+    }
+    if (!xyz.empty()) D3D_AddWindshield(info.ib, xyz.data(), (int)xyz.size() / 9);
+}
